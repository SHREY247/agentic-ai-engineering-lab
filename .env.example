# Copy this file to .env and paste your own keys there. Never commit or share .env.
GROQ_API_KEY=paste-your-groq-key-here
GEMINI_API_KEY=paste-your-gemini-key-here
# Defaults; override only if those exact models are available to your account.
# gemini-2.5-* models are limited to accounts that already used them, so new keys should use 3.5.
GROQ_MODEL=groq/openai/gpt-oss-120b
GEMINI_MODEL=gemini/gemini-3.5-flash-lite
# Optional; use a Python venv for live runs.
# macOS / Linux:
# PYTHON=.venv/bin/python
# Windows:
# PYTHON=.venv\Scripts\python.exe
PORT=4173

# Free-tier budget for one run. A typical successful run uses about 11 Gemini and 4-6 Groq calls.
CAMPUSBITES_GEMINI_CALL_CAP=16
CAMPUSBITES_GROQ_CALL_CAP=10
# Calls are spaced out to stay under per-minute limits (lower these if you see rate-limit waits).
CAMPUSBITES_GEMINI_RPM=10
CAMPUSBITES_GROQ_RPM=6
# How many times the manager may send work back to a developer after QA fails.
CAMPUSBITES_MAX_CORRECTIONS=1
